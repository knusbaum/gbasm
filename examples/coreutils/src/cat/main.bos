package main

import "io"
import "fmt"
import "flags/gnu"

var conf struct{
	numberNonBlank bool
	showEnds bool
	number bool
	squeezeBlank bool
	showTabs bool
	showNonprinting bool
}

fn scmp(a []byte, b []byte) i64 {
	if (len(a) < len(b)) {
		return -1
	} else if (len(a) > len(b)) {
		return 1
	}
	// same length
	for(var i := 0; i < len(a); i+=1) {
		if (a[i] < b[i]) {
			return -1
		} else if (a[i] > b[i]) {
			return 1
		}
	}
	return 0
}

fn main(args [][]byte) i64 {
	p := gnu.Parser.new(args, "AbeEnstTuv", [
		gnu.Option{name: "show-all", value: i64('A')},
		gnu.Option{name: "number-nonblank", value: i64('b')},
		gnu.Option{name: "show-ends", value: i64('E')},
		gnu.Option{name: "number", value: i64('n')},
		gnu.Option{name: "squeeze-blank", value: i64('s')},
		gnu.Option{name: "show-tabs", value: i64('T')},
		gnu.Option{name: "show-nonprinting", value: i64('v')},
		gnu.Option{name: "help", value: 256},
		gnu.Option{name: "version", value: 257},
		][:])

	for(var t := p.next(); t != -1; t = p.next()) {
		if(p.error != gnu.Error.NONE) {
			e := []byte(p.error)
			fmt.printf(&io.STDERR, "ERROR (%v): %v\n", &p.token, &e)
			p.destroy()
			return 1
		}
		switch (t) {
			case i64('A') {
				conf.showNonprinting = true
				conf.showEnds = true
				conf.showTabs = true
			}
			case i64('b') { conf.numberNonBlank = true }
			case i64('e') {
				conf.showNonprinting = true
				conf.showEnds = true
			}
			case i64('E') { conf.showEnds = true }
			case i64('n') { conf.number = true }
			case i64('s') { conf.squeezeBlank = true }
			case i64('t') {
				conf.showNonprinting = true
				conf.showTabs = true
			}
			case i64('T') { conf.showTabs = true }
			case i64('u') {}
			case i64('v') { conf.showNonprinting = true }
			case 256 {
				fmt.print("show help\n")
				p.destroy()
				return 0
			}
			case 257 {
				fmt.print("show version\n")
				p.destroy()
				return 0
			}
		}
	}

	ops := p.operands()
	bw := io.buffered_writer.new(&io.STDOUT)
	var out := modifier{w: bw, line: 1, lineStart: true}
	if (len(ops) == 0) {
		// no args (just the program name). Copy stdin.
		err := io.copy(&out, &io.STDIN)
		if(err != nil) {
			fmt.printf(&io.STDERR, "Error: %v\n", err)
			p.destroy()
			bw.close()
			return 1
		}
		p.destroy()
		var ret := 0
		err2 := out.finish()
		if (err2) {
			fmt.printf(&io.STDERR, "Error: %v\n", err2)
			ret = 1
		}
		err3 := bw.close()
		if (err3) {
			fmt.printf(&io.STDERR, "Error: %v\n", err3)
			ret = 1
		}
		return ret
	}
	var ret := 0
	for(var i i64 := 0; i < len(ops); i += 1) {
		//if (scmp(ops[i], "-") == 0) {
		if (ops[i][0] == '-') {
			err := io.copy(&out, &io.STDIN)
			if(err != nil) {
				fmt.printf(&io.STDERR, "Error: %v\n", err)
				ret = 1
			}
			continue
		}

		fd := switch (r := io.open(ops[i], io.O_RDONLY, 0o660)) {
			case io.error {
				fmt.printf(&io.STDERR, "While opening %s: %v\n", &ops[i], r)
				ret = 1
				continue
			}
			case owned io.FD r
		}
		err := io.copy(&out, &fd)
		if(err != nil) {
			fmt.printf(&io.STDERR, "Error: %v\n", err)
			fd.close()
			ret = 1
			continue
		}
		fd.close()
	}
	p.destroy()
	err2 := out.finish()
	if (err2) {
		fmt.printf(&io.STDERR, "Error: %v\n", err2)
		ret = 1
	}
	err3 := bw.close()
	if (err3) {
		fmt.printf(&io.STDERR, "Error: %v\n", err3)
		ret = 1
	}
	return ret
}

// A single output filter preserves line state across chunks and operands.
// The downstream buffered_writer handles buffering and full writes; this
// type owns no storage.
type modifier struct {
	w *mut io.buffered_writer
	line i64
	lineStart bool
	blankSeen bool
	pendingCR bool
} {
	number_line(m *mut modifier) ?io.error {
		var digits [32]byte
		var pos := 31
		digits[pos] = 9
		var n := m.line
		for (;;) {
			pos -= 1
			digits[pos] = byte(48 + n % 10)
			n /= 10
			if (n == 0) {
				break
			}
		}
		for (; pos > 25; ) {
			pos -= 1
			digits[pos] = 32
		}
		_, err := m.w.write(digits[pos:])
		if (err) {
			return err
		}
		m.line += 1
		return nil
	}
	write(m *mut modifier, buf []byte) i64, ?io.error {
		if (!conf.number && !conf.numberNonBlank && !conf.squeezeBlank && !conf.showEnds && !conf.showTabs && !conf.showNonprinting) {
			n, err := m.w.write(buf)
			return n, err
		}
		for (var i := 0; i < len(buf); i += 1) {
			ch := buf[i]
			// With -E alone, CR is special only immediately before LF. Delay
			// that one byte so CRLF works even across writes or file boundaries.
			if (m.pendingCR) {
				var cr [1]byte
				cr[0] = 13
				if (ch == 10) {
					_, err := m.w.write("^M")
					if (err) { return i, err }
				} else {
					_, err := m.w.write(cr[:])
					if (err) { return i, err }
				}
				m.pendingCR = false
			}
			if (ch == 10) {
				if (m.lineStart) {
					if (conf.squeezeBlank && m.blankSeen) {
						continue
					}
					m.blankSeen = true
					if (conf.number && !conf.numberNonBlank) {
						err := m.number_line()
						if (err) {
							return i, err
						}
					}
				} else {
					m.blankSeen = false
				}
				if (conf.showEnds) {
					_, err := m.w.write("$")
					if (err) {
						return i, err
					}
				}
				_, err := m.w.write("\n")
				if (err) {
					return i, err
				}
				m.lineStart = true
				continue
			}
			if (m.lineStart) {
				if (conf.number || conf.numberNonBlank) {
					err := m.number_line()
					if (err) {
						return i, err
					}
				}
				m.lineStart = false
			}
			if (ch == 13 && conf.showEnds && !conf.showNonprinting) {
				m.pendingCR = true
				continue
			}
			var encoded [4]byte
			var count := 0
			var c := i64(ch)
			if (ch == 9 && conf.showTabs) {
				encoded[0] = 94
				encoded[1] = 73
				count = 2
			} else if (conf.showNonprinting && ch != 9) {
				// M- means the high bit was set. Render the remaining seven bits
				// normally: 0x80 -> M-^@, 0xa0 -> M- , 0xff -> M-^?.
				if (c >= 128) {
					encoded[0] = 77
					encoded[1] = 45
					count = 2
					c -= 128
				}
				if (c < 32) {
					encoded[count] = 94
					count += 1
					c += 64
				} else if (c == 127) {
					encoded[count] = 94
					count += 1
					c = 63
				}
				encoded[count] = byte(c)
				count += 1
			} else {
				encoded[0] = ch
				count = 1
			}
			_, err := m.w.write(encoded[:count])
			if (err) {
				return i, err
			}
		}
		return len(buf), nil
	}
	finish(m *mut modifier) ?io.error {
		if (m.pendingCR) {
			var cr [1]byte
			cr[0] = 13
			_, err := m.w.write(cr[:])
			if (err) {
				return err
			}
			m.pendingCR = false
		}
		return nil
	}
}
