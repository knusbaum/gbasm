package main

import "io"
import "fmt"
import "flags/gnu"

var conf struct{
	numberNonBlank bool
	showEnds bool
	number bool
	squeezeBlank bool
	showTabs bool
	showNonprinting bool
}

fn scmp(a []byte, b []byte) i64 {
	if (len(a) < len(b)) {
		return -1
	} else if (len(a) > len(b)) {
		return 1
	}
	// same length
	for(var i := 0; i < len(a); i+=1) {
		if (a[i] < b[i]) {
			return -1
		} else if (a[i] > b[i]) {
			return 1
		}
	}
	return 0
}

fn main(args [][]byte) i64 {
	p := gnu.Parser.new(args, "AbeEnstTuv", [
		gnu.Option{name: "show-all", value: i64('A')},
		gnu.Option{name: "number-nonblank", value: i64('b')},
		gnu.Option{name: "show-ends", value: i64('E')},
		gnu.Option{name: "number", value: i64('n')},
		gnu.Option{name: "squeeze-blank", value: i64('s')},
		gnu.Option{name: "show-tabs", value: i64('T')},
		gnu.Option{name: "show-nonprinting", value: i64('v')},
		gnu.Option{name: "help", value: 256},
		gnu.Option{name: "version", value: 257},
		][:])

	for(var t := p.next(); t != -1; t = p.next()) {
		if(p.error != gnu.Error.NONE) {
			e := []byte(p.error)
			fmt.printf(&io.STDERR, "ERROR (%v): %v\n", &p.token, &e)
			p.destroy()
			return 1
		}
		switch (t) {
			case i64('A') {
				conf.showNonprinting = true
				conf.showEnds = true
				conf.showTabs = true
			}
			case i64('b') { conf.numberNonBlank = true }
			case i64('e') {
				conf.showNonprinting = true
				conf.showEnds = true
			}
			case i64('E') { conf.showEnds = true }
			case i64('n') { conf.number = true }
			case i64('s') { conf.squeezeBlank = true }
			case i64('t') {
				conf.showNonprinting = true
				conf.showTabs = true
			}
			case i64('T') { conf.showTabs = true }
			case i64('u') {}
			case i64('v') { conf.showNonprinting = true }
			case 256 {
				fmt.print("show help\n")
				p.destroy()
				return 0
			}
			case 257 {
				fmt.print("show version\n")
				p.destroy()
				return 0
			}
		}
	}

	ops := p.operands()
	if (len(ops) == 0) {
		// no args (just the program name). Copy stdin.
		err := io.copy(&io.STDOUT, &io.STDIN)
		if(err != nil) {
			fmt.printf(&io.STDERR, "Error: %v\n", err)
			p.destroy()
			return 1
		}
		p.destroy()
		return 0
	}
	var ret := 0
	for(var i i64 := 0; i < len(ops); i += 1) {
		if (scmp(ops[i], "-") == 0) {
			err := io.copy(&io.STDOUT, &io.STDIN)
			if(err != nil) {
				fmt.printf(&io.STDERR, "Error: %v\n", err)
				ret = 1
			}
			continue
		}

		fd := switch (r := io.open(ops[i], io.O_RDONLY, 0o660)) {
			case io.error {
				fmt.printf(&io.STDERR, "While opening %s: %v\n", &ops[i], r)
				ret = 1
				continue
			}
			case owned io.FD r
		}
		err := io.copy(&io.STDOUT, &fd)
		if(err != nil) {
			fmt.printf(&io.STDERR, "Error: %v\n", err)
			fd.close()
			ret = 1
			continue
		}
		fd.close()
	}
	p.destroy()
	return ret
}
