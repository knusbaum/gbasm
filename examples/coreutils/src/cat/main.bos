package main

import "io"
import "fmt"

fn main(args [][]byte) {
	if (len(args) == 1) {
		// no args (just the program name). Copy stdin.
		err := io.copy(&io.STDOUT, &io.STDIN)
		if(err != nil) {
			fmt.print("Error: %v\n", err)
			return
		}
		return
	}
	for(var i i64 := 1; i < len(args); i = i + 1) {
		f, openerr := io.open(args[i], io.O_CREAT | io.O_RDONLY, 0o660)
		if (openerr != nil) {
			fmt.print("While opening %s: %v\n", &args[i], openerr)
			dispose(f) // Interesting we can't coherently dispose f close(f) feels wrong here.
			return
		}
		err := io.copy(&io.STDOUT, &f)
		if(err != nil) {
			fmt.print("Error: %v\n", err)
			f.close()
			return
		}
		f.close()
	}
	fmt.str(&io.STDOUT, "Done.\n")
}
