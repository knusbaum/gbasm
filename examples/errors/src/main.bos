package main

import "fmt"
import "io"




type my_error struct{ x i64, y i64, msg []byte} {
	new(x i64, y i64, msg []byte) owned *my_error {
		return new(my_error{x: x, y:y, msg: msg})
	}
	
	format(self *my_error, w io.writer) ?io.error {
		_, err := fmt.printf(w, "my_error{x: %d, y: %d, msg: %s}", self.x, self.y, &self.msg)
		return err
	}

	destroy(self owned *my_error) {
		fmt.print("Destroyed my_error\n")
		free(self)
	}
}

fn main() {
	x := something_that_errors()
	fmt.print("X: %v\n", x)
	x.destroy()

	b := fmt.StringBuilder.new()
	for(var i := 0; i < 1000; i += 1) {
		fmt.printf(b, "Hello, this is a bunch of shit: %v %v %v %v\n", i, foo{}, 3, 4)
	}
	s := b.to_string()
	fmt.print("Stringbuilder built this: '%v'\n", &s)
	free(s)

	err := strerr_tester()
	if(err) {
		fmt.print("Error: %v\n", err)
		err.destroy()
	}
	
}

fn something_that_errors() owned io.built_error {
	a := my_error.new(10, 100, "what's up?")
	return a
}

fn strerr_tester() ?owned io.built_error {
	e := something_that_errors()
	e2 := fmt.strerr.new("Testing out an error string: %v %v", e, 10)
	e.destroy()
	return e2
}

type foo struct { x owned i64 } {
	format(self foo, w io.writer) ?io.error {
		_, err := fmt.printf(w, "foo{x: %d}", self.x)
		return err
	}
}

fn other() {
	var a owned foo := {x: 10}
	b owned i64 := a.x
	a.x = 100

	fmt.print("a: %v\n", &a)
	fmt.print("b: %v\n", b)
	dispose(a)
	dispose(b)

	var c := cats.RED{lives: 10}
	c = cats.BLUE{claws: true}
	fmt.print("Cat: %v\n", &c)
}

type cats values {
	RED{lives i64},
	BLUE{claws bool},
} {
	format(self *cats, w io.writer) ?io.error {		
		switch (s := *self) {
			case RED {
				_, err := fmt.printf(w, "Red cat with %d lives.", s.lives)
				return err
			}
			case BLUE {
				if (s.claws) {
					_, err := fmt.printf(w, "Bue cat with no claws")
					return err
				} else {
					_, err := fmt.printf(w, "Bue cat with no claws")
					return err
				}
			}
		}
		//return nil
	}
}
