package main

import "io"
import "fmt"

fn perror(err io.error) {
	fmt.printf(&io.STDERR, "ERROR: %v\n", err)
}

fn main(args [][]byte) {
	if (len(args) == 1) {
		// no args (just the program name). Copy stdin.
		err := io.copy(&io.STDOUT, &io.STDIN)
		if(err != nil) {
			perror(err)
			return
		}
		fmt.str(&io.STDOUT, "Done.\n")
		return
	}
	for(var i i64 := 1; i < len(args); i = i + 1) {
		f := switch (r := io.open(args[i], io.O_CREAT | io.O_RDONLY, 0o660)) {
			case ERR {
				fmt.printf(&io.STDERR, "While opening %s: %v\n", &args[i], r.err)
				return
			}
			case FD r.fd
		}
		err := io.copy(&io.STDOUT, &f)
		if(err != nil) {
			perror(err)
			f.close()
			return
		}
		f.close()
	}
	fmt.str(&io.STDOUT, "Done.\n")
}
