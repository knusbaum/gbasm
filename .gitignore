# Build outputs — the toolchain binaries (built by `make all` / mmk)
/bosc
/bas
/bld
/bdoc
/bplayd
/bplay-runner
/bdump
/btourd

# Per-subproject build binaries + test-harness intermediates
cmd/bosc/bosc
cmd/bosc/bas
cmd/bosc/bld
cmd/bas/bas
cmd/bas/bld
cmd/bosc/*.bo
cmd/bosc/*.importcfg
# Every .bs bosc emits while building the test-harness packages. A glob rather
# than a per-package list, which went stale each time a runtime package was
# added. Test fixtures live in cmd/bosc/tests/ and are not matched.
cmd/bosc/*.bs

# Build artifacts (mmk writes package .bo files and work dirs under target/)
/target/
examples/*/target/

# Compiler scratch emitted next to inputs during ad-hoc runs
/main.bs
cmd/bosc/main.bs

# Editor / session scratch
*~
\#*\#
.\#*
claude.txt
codex.txt

# Saved web pages (docs scraped for reference, not part of the repo)
*.html
# ...but the app frontends' own pages ARE part of the repo (served via
# go:embed). The broad *.html above is for scraped reference docs only.
!cmd/bplayd/static/index.html
!cmd/btourd/static/index.html
*\ Packages_files/
