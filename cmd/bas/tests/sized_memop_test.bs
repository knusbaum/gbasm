package main

// Sized memory operands must touch exactly the bytes they name — no more, no
// fewer — at any offset, aligned or not.
//
// This matters more in Boson than in most ABIs because struct fields are
// packed with no padding (DESIGN.md "The Boson ABI (BABI-0)"), so a field's
// neighbours sit immediately against it. There is no slack to absorb a store
// that runs long, and a narrow field frequently lands at an unaligned offset.
// An oversized store is therefore silent corruption of an adjacent field
// rather than a harmless write into padding.
//
// Each case writes into the MIDDLE of a canary-filled buffer, so an overrun
// lands on canary bytes that the dump reveals, rather than off the end of the
// buffer where it would corrupt the frame and turn a wrong answer into a
// crash. Byte 0xEE is the canary; every case prints the whole 24-byte window.
//
// The read cases are the mirror image: reading more than the named width
// picks up neighbouring canary bytes and shows up as a wrong value.

// dumpbuf(ptr *byte, n i64) — print n bytes at ptr as decimal, space-separated.
function dumpbuf
	argi ptr 0
	argi n 1
	prologue
	local i 64
	mov i 0

	label loop
	cmp i n
	jge done
	acquire rdi
	movzx rdi byte[ptr+i*1]
	call string.puti
	mov rdi 0x20
	call string.putc
	release rdi
	add i 1
	jmp loop

	label done
	acquire rdi
	mov rdi 0x0A
	call string.putc
	release rdi
	epilogue
	ret

// fillcanary(ptr *byte) — set 24 bytes to 0xEE.
function fillcanary
	argi ptr 0
	prologue
	// x86-64 has no mov r/m64, imm64 -- the canary goes through a register.
	local pat 64
	mov pat 0xEEEEEEEEEEEEEEEE
	mov qword[ptr+0] pat
	mov qword[ptr+8] pat
	mov qword[ptr+16] pat
	epilogue
	ret

function show
	argi ptr 0
	prologue
	acquire rdi
	mov rdi ptr
	acquire rsi
	mov rsi 24
	call dumpbuf
	release rsi
	release rdi
	epilogue
	ret

function main
	prologue
	bytes buf 24

	// --- writes: an immediate through a sized operand ---

	// byte: exactly one byte at an odd offset.
	acquire rdi
	mov rdi buf
	call fillcanary
	release rdi
	mov byte[buf+9] 0x11
	acquire rdi
	mov rdi buf
	call show
	release rdi

	// word: exactly two bytes, unaligned.
	acquire rdi
	mov rdi buf
	call fillcanary
	release rdi
	mov word[buf+9] 0x2233
	acquire rdi
	mov rdi buf
	call show
	release rdi

	// dword: exactly four bytes, unaligned. This is the width a packed i32
	// field most often lands on.
	acquire rdi
	mov rdi buf
	call fillcanary
	release rdi
	mov dword[buf+9] 0x44556677
	acquire rdi
	mov rdi buf
	call show
	release rdi

	// qword: exactly eight bytes, unaligned. A full-width immediate has no
	// memory-destination encoding on x86-64, so it goes through a register.
	acquire rdi
	mov rdi buf
	call fillcanary
	release rdi
	acquire rax
	mov rax 0x0102030405060708
	mov qword[buf+9] rax
	release rax
	acquire rdi
	mov rdi buf
	call show
	release rdi

	// A small immediate into a wide slot must still write the full width --
	// this is the documented hazard the sized form exists to defeat. All
	// eight bytes at +9 must be written, seven of them zero.
	acquire rdi
	mov rdi buf
	call fillcanary
	release rdi
	mov qword[buf+9] 1
	acquire rdi
	mov rdi buf
	call show
	release rdi

	// The contrast case, pinned deliberately: an UNSIZED operand takes its
	// width from the source. With a small immediate that is the narrowest
	// opcode, so this writes ONE byte and leaves the other seven canary --
	// which is why a 64-bit slot must use the qword form above. Without this
	// case the one above could pass while proving nothing.
	acquire rdi
	mov rdi buf
	call fillcanary
	release rdi
	mov [buf+9] 1
	acquire rdi
	mov rdi buf
	call show
	release rdi

	// The same rule with a register source gives the register's width: eight
	// bytes, not one. "Unsized takes the source's width" covers both.
	acquire rdi
	mov rdi buf
	call fillcanary
	release rdi
	acquire rax
	mov rax 1
	mov [buf+9] rax
	release rax
	acquire rdi
	mov rdi buf
	call show
	release rdi

	// --- writes: a register source through a sized operand ---

	acquire rdi
	mov rdi buf
	call fillcanary
	release rdi
	acquire rax
	mov rax 0x99AABBCC11223344
	mov dword[buf+9] eax
	release rax
	acquire rdi
	mov rdi buf
	call show
	release rdi

	// --- reads ---

	// Lay down a known ascending pattern, then read sized windows out of it.
	// A read that is too wide picks up its neighbours and prints wrong.
	mov byte[buf+8]  0x01
	mov byte[buf+9]  0x02
	mov byte[buf+10] 0x03
	mov byte[buf+11] 0x04
	mov byte[buf+12] 0x05
	mov byte[buf+13] 0x06
	mov byte[buf+14] 0x07
	mov byte[buf+15] 0x08

	// byte read at +9 -> 0x02 = 2
	acquire rdi
	movzx rdi byte[buf+9]
	call string.puti
	mov rdi 0x0A
	call string.putc
	release rdi

	// word read at +9 -> 0x0302 = 770
	acquire rdi
	movzx rdi word[buf+9]
	call string.puti
	mov rdi 0x0A
	call string.putc
	release rdi

	// dword read at +9 -> 0x05040302 = 84148994
	acquire rdi
	mov edi dword[buf+9]
	call string.puti
	mov rdi 0x0A
	call string.putc
	release rdi

	// qword read at +8 -> 0x0807060504030201 = 578437695752307201
	acquire rdi
	mov rdi qword[buf+8]
	call string.puti
	mov rdi 0x0A
	call string.putc
	release rdi

	epilogue
	xor rax rax
	ret
