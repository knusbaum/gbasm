package main
import "string"
type Result values {ERR{code i64};FD{fd owned i64}}
fn make_result(ok bool) owned Result {
 if(ok) {return Result.FD{fd:owned(i64(37))}}
 return Result.ERR{code:1}
}
fn use(ok bool) {
 var fd owned i64
 switch (r:=make_result(ok)) {case ERR {return} case FD {fd=r.fd}}
 string.puti(fd);string.puts("\n");dispose(fd)
}
fn main() {use(false);use(true)}
