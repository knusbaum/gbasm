package main
import "string"
type Result values {ERR{code i64};FD{fd owned i64}}
fn make_result(ok bool) owned Result {
 if(ok) {return Result.FD{fd:owned(i64(37))}}
 return Result.ERR{code:1}
}
fn extract(ok bool) owned i64 {
 return switch r := make_result(ok) {
  case ERR {return owned(i64(9))}
  case FD r.fd
 }
}
fn main() {x:=extract(true);string.puti(x);string.puts("\n");dispose(x);y:=extract(false);string.puti(y);string.puts("\n");dispose(y)}
