package main

import "fmt"

// pop removes the last element, returning the shortened slice and the element.
// Fill, then drain to empty; len shrinks and cap is preserved.
fn main() {
	var s := make([]mut i64, 0, 3)
	s = append(s, 10)
	s = append(s, 20)
	s = append(s, 30)
	var x i64 := 0
	s, x = pop(s)
	fmt.print("%d %d %d\n", x, len(s), cap(s))   // 30 2 3
	s, x = pop(s)
	fmt.print("%d %d %d\n", x, len(s), cap(s))   // 20 1 3
	s, x = pop(s)
	fmt.print("%d %d %d\n", x, len(s), cap(s))   // 10 0 3
	free(s)
}
