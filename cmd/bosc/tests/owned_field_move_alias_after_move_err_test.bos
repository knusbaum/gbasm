package main

import "fmt"

// Local alias creation is allowed after a move; reading its consumed field
// is rejected until that field is restored.
type foo struct {
	a owned *mut i64
}

fn main() {
	var f owned foo := foo{a: alloc(i64)}
	free(f.a)
	var alias *foo := &f
	fmt.print("%d\n", *alias.a)
	dispose(f)
}
