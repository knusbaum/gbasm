package main

// Soundness boundary for self-consuming reassignment: fresh() returns a new
// owned i64 but does NOT consume x, so x's obligation is still live at the
// assignment. Reassigning x here would drop that live obligation (a leak), so it
// must stay rejected — the post-RHS drop check observes that x was not consumed.
// Contrast the accepted `x = inc(x)`, where the RHS *does* consume x.
fn fresh() owned i64 {
	n := 99
	return owned(n)
}

fn main() {
	var x owned i64 := 5
	x = fresh()
	dispose(x)
}
