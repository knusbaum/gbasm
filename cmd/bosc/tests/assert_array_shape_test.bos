package main
import "string"

// m2 regression: an ARRAY shape with length > 15 must encode (the old 4-bit
// length field capped at 15 and rejected [16]byte). &arr is *([16]byte); the
// coercion links and runs. Asserting it to [16]*byte (which parses as a SLICE-
// shaped (*byte)[16] — array of pointers, a different shape) is correctly
// false, and asserting it to [32]*byte is likewise false: the shape word
// distinguishes array lengths.
fn main() i64 {
	var arr [16]byte
	arr[0] = 90
	a any := &arr
	string.puts("arr16 coerced ")
	_ [16]*byte, ok16 bool := a.([16]*byte)
	_ [32]*byte, ok32 bool := a.([32]*byte)
	if (ok16) { string.puts("16y ") } else { string.puts("16n ") }
	if (ok32) { string.puts("32y ") } else { string.puts("32n ") }
	string.putc(10)
	return 0
}
