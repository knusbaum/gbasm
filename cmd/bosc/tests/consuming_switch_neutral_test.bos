package main
import "string"
type Result values {ERR{code i64};FD{fd owned i64}}
fn make_result(ok bool) owned Result {
 if(ok) {return Result.FD{fd:owned(i64(37))}}
 return Result.ERR{code:1}
}
type V values {A{a owned i64};B{b owned i64};EMPTY{n i64}}
fn main() {
 v owned V:=V.EMPTY{n:7}
 switch (v) {
  case A {drop(v.a)}
  case B {drop(v.b)}
  case EMPTY {string.puti(v.n);string.puts("\n")}
 }
}
fn drop(x owned i64) {dispose(x)}
