package main

import "fmt"

// Aliases stored in a struct retain consumed-field state; reading through
// the stored pointer is rejected until the field is restored.
type foo struct {
	a owned *mut i64
}

type holder struct {
	p *foo
}

fn main() {
	var f owned *owned mut foo := new(foo{a: alloc(i64)})
	free(f.a)
	var h holder := holder{p: f}
	fmt.print("%d\n", *h.p.a)
	free(f)
}
