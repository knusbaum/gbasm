package main

type leaf struct {
	val i64
}

type box struct {
	val i64
	child owned ?*owned mut leaf
}

// A mutable borrowed view exposes child's ownership; overwriting it must
// discharge its current obligation even when the pointee alias is unknown.
var saved ?*mut box

fn destroy(b owned *owned mut box) {
	var child owned ?*owned mut leaf := b.child
	if(saved) {
		saved?.child = nil
	}
	free(b)
	if(child) {
		free(child)
	}
}

fn main() {}
