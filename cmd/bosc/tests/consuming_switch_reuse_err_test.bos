package main
import "string"
type Result values {ERR{code i64};FD{fd owned i64}}
fn make_result(ok bool) owned Result {
 if(ok) {return Result.FD{fd:owned(i64(37))}}
 return Result.ERR{code:1}
}
fn main() {
 r:=make_result(true)
 switch r {case ERR {} case FD {drop(r.fd)}}
 dispose(r)
}

fn drop(x owned i64) {dispose(x)}
