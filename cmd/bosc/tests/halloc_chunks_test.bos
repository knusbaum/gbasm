package main

import "string"
import "_halloc"

// Scaffold-level checks: chunk acquisition, alignment, the registry, and span
// runs. These are the invariants everything above them assumes -- if chunk
// alignment is wrong, the masking that finds a span descriptor silently reads
// the wrong memory rather than failing.

fn line(n i64) {
	string.puti(n)
	string.putc('\n')
}

fn main() {
	// Nothing mapped until something is asked for.
	line(_halloc.chunk_count())
	line(_halloc.reserve_count())

	// One span. Must come back CHUNK_SIZE-aligned at the chunk level and
	// SPAN_SIZE-aligned at the span level, or pointer masking cannot find the
	// descriptor.
	a := _halloc.span_alloc_for_test(1)
	if (a != uintptr(0)) { line(1) } else { line(0) }
	line(i64(a & uintptr(65535)))
	line(_halloc.chunk_count())

	// Span 0 is metadata, so the first allocatable span is span 1.
	line(i64((a & uintptr(4194303)) / uintptr(65536)))

	// 63 allocatable spans per chunk; one is taken.
	line(_halloc.free_span_count())

	// A run of 4 contiguous spans.
	b := _halloc.span_alloc_for_test(4)
	if (b != uintptr(0)) { line(1) } else { line(0) }
	line(i64(b & uintptr(65535)))
	line(_halloc.free_span_count())

	// The run must not overlap the first allocation.
	if (b != a) { line(1) } else { line(0) }

	// Give both back; the chunk stays mapped (release policy is a later task).
	_halloc.span_free_for_test(a, 1)
	_halloc.span_free_for_test(b, 4)
	line(_halloc.free_span_count())
	line(_halloc.chunk_count())

	// Exhaust one chunk: 63 single spans fit, the 64th forces a second chunk.
	var i i64 := 0
	for (; i < 63; i = i + 1) {
		_ := _halloc.span_alloc_for_test(1)
	}
	line(_halloc.chunk_count())
	line(_halloc.free_span_count())
	_ := _halloc.span_alloc_for_test(1)
	line(_halloc.chunk_count())

	// One 1GiB reserve holds 256 chunks, so none of the above needed a second.
	line(_halloc.reserve_count())

	// A run larger than a chunk's capacity cannot be satisfied -- and must not
	// map a chunk on the way to finding that out.
	before := _halloc.chunk_count()
	big := _halloc.span_alloc_for_test(64)
	if (big == uintptr(0)) { line(1) } else { line(0) }
	line(_halloc.chunk_count() - before)

	// Every chunk base must be CHUNK_SIZE-aligned. This is the invariant that
	// pointer masking depends on: if it fails, chunk_of() silently computes the
	// wrong base and reads a descriptor out of unrelated memory.
	//
	// Asserted directly on every chunk rather than inferred from a span
	// address, because the kernel often returns a large mapping already
	// suitably aligned -- an inferred check passes by luck even when the
	// alignment code is absent.
	// A released chunk must stop being recognized: chunk_of has to consult the
	// in-use bit, not merely decide the address falls inside a reserve.
	// Reachable only through the chunk layer directly -- via spans, a chunk is
	// always live.
	cb := _halloc.chunk_alloc_for_test()
	if (_halloc.chunk_of_for_test(cb) == cb) { line(1) } else { line(0) }
	_halloc.chunk_release_for_test(cb)
	if (_halloc.chunk_of_for_test(cb) == uintptr(0)) { line(1) } else { line(0) }

	// Every reserve base must be CHUNK_SIZE-aligned. That is the invariant the
	// whole masking scheme rests on: chunks sit at multiples of CHUNK_SIZE
	// inside a reserve, so if the reserve is misaligned every chunk is, and
	// chunk_of() silently reads a descriptor out of unrelated memory.
	//
	// Whether removing the trim is CAUGHT depends on ASLR, and that is a
	// property of the environment rather than a gap in the test. These
	// reservations come back 2MB-aligned -- one bit short of CHUNK_SIZE -- so
	// about half of runs are CHUNK_SIZE-aligned anyway, and in those runs the
	// untrimmed allocator is genuinely correct. There is nothing to detect.
	//
	// In the other half the failure is loud and lands on several assertions at
	// once: the span-index line above reads 33 instead of 1, because span_index
	// masks by CHUNK_MASK and a chunk 2MB off resolves every pointer 32 spans
	// wrong. Measured over 12 mutated runs: 7 caught, 5 correct-by-luck.
	//
	// Extra reserves do not add samples. Consecutive reservations are spaced by
	// a multiple of CHUNK_SIZE, so every reserve inherits the first one's
	// alignment -- an attempt to break that with a 2MB spacer between them
	// changed nothing, and was removed rather than left looking effective.
	_ := _halloc.reserve_new_for_test()

	var badres i64 := 0
	var j i64 := 0
	for (; j < _halloc.reserve_count(); j = j + 1) {
		if ((_halloc.reserve_base_at_for_test(j) & uintptr(4194303)) != uintptr(0)) {
			badres = badres + 1
		}
	}
	line(badres)

	var bad i64 := 0
	var k i64 := 0
	for (; k < _halloc.chunk_count(); k = k + 1) {
		if ((_halloc.chunk_base_at_for_test(k) & uintptr(4194303)) != uintptr(0)) {
			bad = bad + 1
		}
	}
	line(bad)
}
