package main

// Moving an owned field is allowed with aliases, but passing the inconsistent
// aggregate through an alias must fail before the callee can read that field.
type foo struct {
	x owned i64
}

fn consume(v owned i64) {
	dispose(v)
}

fn peek(f *foo) i64 {
	return f.x
}

fn main() {
	var a owned foo := foo{x: 10}
	alias *foo := &a
	consume(a.x)
	_ := peek(alias)
	dispose(a)
}
