package main

import "io"

import "fmt"

// myError implements the standard io.error interface.
type myError i64 {
    format(_ *myError, w io.writer) ?io.error {
        _, err := w.write("something went wrong")
        return err
    }
    destroy(e owned *myError) {
        dispose(e)
    }
}

fn showError(err io.error) {
    fmt.print("%v\n", err)
}

fn main(_ [][]byte) {
    var e myError := 0
    showError(&e)
}
