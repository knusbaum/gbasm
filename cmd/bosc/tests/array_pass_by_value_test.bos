package main

import "string"

// Passing an array copies it (value semantics): the callee mutating its
// parameter must NOT change the caller's array. Arrays are the one aggregate
// that is passed by value, so this pins a semantic any backend must preserve.
fn mutate(var a [3]i64) {
	a[0] = 999
}

fn main() {
	nums [3]i64 := [1, 2, 3]
	mutate(nums)
	string.puti(nums[0])
	string.putc(10)
}
