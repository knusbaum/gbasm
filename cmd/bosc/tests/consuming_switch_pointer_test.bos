package main
import "string"
type Result values {ERR{code i64};FD{fd owned i64}}
fn make_result(ok bool) owned Result {
 if(ok) {return Result.FD{fd:owned(i64(37))}}
 return Result.ERR{code:1}
}
type P values {FAIL;OK{p owned *mut i64}}
fn create() owned P {return P.OK{p:new(i64(13))}}
fn main() {
 p:=switch r:=create() {case FAIL {return} case OK r.p}
 string.puti(*p);string.puts("\n");free(p)
}
