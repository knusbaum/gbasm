package main

import "io"
import "string"

fn discard(r owned io.FD | io.error) {
    switch(r) {case owned io.FD {r.close()} case io.error {}}
}

fn main() i64 {
    fd := switch (r := io.open("/dev/null", io.O_RDONLY, 0)) {
        case io.error { return 1 }
        case owned io.FD r
    }
    var buf [1]byte
    n, err := fd.read(buf[:])
    fd.close()
    if (n != 0 || err != nil) { return 2 }

    // A non-directory path component guarantees failure without relying
    // on an absent filename in the test environment.
    switch (r := io.open("/dev/null/child", io.O_RDONLY, 0)) {
        case io.error {
            if (r != io.io_err.ENOTDIR) { return 3 }
        }
        case owned io.FD { r.close(); return 4 }
    }

    var long_path [4096]byte
    switch (r := io.open(long_path[:], io.O_RDONLY, 0)) {
        case io.error {
            if (r != io.io_err.ENAMETOOLONG) { return 5 }
        }
        case owned io.FD { r.close(); return 6 }
    }

    // A consuming helper must accept and discharge either alternative.
    unused := io.open("/dev/null", io.O_RDONLY, 0)
    discard(unused)
    failed := io.open("/dev/null/child", io.O_RDONLY, 0)
    discard(failed)
    string.puts("ok\n")
    return 0
}
