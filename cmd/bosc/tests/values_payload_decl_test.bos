package main

// Phase 1: a payload-bearing values type (a variant is a struct) declares,
// assembles, links, and runs. Construction / switch / field access are wired
// in later phases; here we only exercise declaration + representation.
type file_info values {
	FILE_INFO{ fd i64, path []byte }
	SOCKET{ fd i64, addr []byte }
	CLOSED
}

