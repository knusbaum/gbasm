package retalias_pkg

// first_word returns a sub-slice of its borrowed parameter. The inferred
// ReturnAliases=[[0]] travels through the .bo so a cross-package consumer
// (in package main) can use the returned view safely — and would be
// rejected at its own call site if it misused it. This is the path the
// .bo-carried alias fact supports.
pub fn first_word(s []byte) []byte {
	var i i64 := 0
	for (; i < len(s); i = i + 1) {
		if (s[i] == 32) {
			return s[0:i]
		}
	}
	return s
}

// borrowing_holder is a concrete type with a borrowing method. A
// cross-package consumer that tries to coerce it to an interface must be
// rejected by the importer-attached ReturnAliases fact (the imported-type
// arm of the interface-coercion guard).
pub type borrowing_holder struct {
	buf []byte
} {
	bytes(h *borrowing_holder) []byte {
		return h.buf
	}
}

pub fn make_holder(s []byte) borrowing_holder {
	return borrowing_holder{buf: s}
}

// viewer declares a borrow contract: `bytes` may return a view of the
// receiver. The declared ReturnAliases ([[0]]) must travel through the .bo so
// a cross-package consumer's ⊆ conformance check admits a borrowing
// implementer (e.g. borrowing_holder). Without that transport the consumer
// would see an empty declared set and wrongly reject the coercion.
pub interface viewer {
	bytes(self *self) []byte from(self)
}

// Union fixtures exercise canonical tags and structural signature metadata.
pub type union_resource struct {n i64}
pub type union_alias bool | owned *mut union_resource
pub fn union_create(ok bool) union_alias {
    if(ok) {return new(union_resource{n:37})}
    return false
}
pub fn union_forward(v owned *mut union_resource | bool) bool | owned *mut union_resource {
    return v
}
pub fn union_borrow(s []byte) bool | []byte {return s}

pub fn optional_number(ok bool) ?i64 {if(ok){return 0};return nil}
pub fn optional_resource(ok bool) ?union_resource {if(ok){return union_resource{n:37}};return nil}
