// Package _halloc is the Boson memory allocator.
//
// Design and rationale: docs/proposed/PROPOSAL_allocator.md. In short, three
// tiers over a single kernel interface --
//
//   small (<= 32KB)  a power-of-two size class, many objects per span
//   large            a run of contiguous 64KB spans inside a chunk
//   huge             direct mmap
//
// -- with the property that only the chunk allocator ever calls the kernel, so
// no ordinary allocation pattern produces a syscall storm.
//
// It is developed under this name so it can be tested against the existing
// allocator; it becomes _heap at cutover.
//
// Constraints it must respect, all consequences of being the allocator:
//   - no alloc/new (it IS those)
//   - no runtime interface assertion, so no fmt %v (that path allocates itabs)
//   - all state in file-scope globals and fixed-size arrays
//
// Single-threaded. There is no locking anywhere.
package _halloc

import "sys"

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

// CHUNK_SIZE is the unit of mmap, and chunks are aligned to it so that both the
// chunk base and the span base are derivable from any pointer by masking.
CHUNK_SIZE i64 := 4194304
CHUNK_MASK uintptr := uintptr(4194303)

// SPAN_SIZE is the unit of sub-allocation. A span holds SPAN_SIZE bytes of
// objects and nothing else -- descriptors live in the chunk's metadata span --
// which is what lets every size class divide it exactly.
SPAN_SIZE i64 := 65536
SPAN_MASK uintptr := uintptr(65535)

SPANS_PER_CHUNK i64 := 64

// Span 0 of every chunk holds the chunk header and all 64 span descriptors.
// One span in 64 is 1.6% overhead, and it avoids a bootstrap problem: chunk
// metadata cannot be heap-allocated by the heap.
METADATA_SPANS i64 := 1

// A reserve is the unit of mmap. Chunks are carved from it by arithmetic, so
// acquiring one costs no syscall and needs no registry.
//
// 1GiB rather than something larger on purpose: a reservation costs address
// space, not memory, but a multi-gigabyte VSZ is an operational annoyance even
// when harmless. This keeps VSZ unremarkable and grows in 1GiB steps.
//
// RESERVE_SIZE is a tuning constant, not an architectural commitment. At
// RESERVE_SIZE == CHUNK_SIZE this degenerates into mapping each chunk
// individually; see the migration note in the proposal.
RESERVE_SIZE i64 := 1073741824
CHUNKS_PER_RESERVE i64 := 256
MAX_RESERVES i64 := 64

// 256 chunk bits per reserve, packed into i64 words.
RES_WORDS i64 := 4

// Span descriptor states.
SPAN_FREE i64 := 0
SPAN_SMALL i64 := 1
SPAN_LARGE_HEAD i64 := 2
SPAN_LARGE_TAIL i64 := 3

// ---------------------------------------------------------------------------
// Metadata layout
// ---------------------------------------------------------------------------

// chunk_hdr sits at the base of every chunk. The span descriptors follow it
// immediately, one per span, addressed by index rather than declared as a
// nested array so the arithmetic is explicit.
type chunk_hdr struct {
	base       uintptr
	free_spans i64
	purged     i64
	pad        i64
}

// span_desc describes one span. It lives in the chunk's metadata span, NOT in
// the span it describes: an in-span header would cost half a span in the
// largest class (2 * 32768 is exactly SPAN_SIZE) and break the tiling of every
// other class.
type span_desc struct {
	state     i64
	class     i64
	free_head uintptr
	bump      uintptr
	used      i64
	clean     i64
	runlen    i64
	next      uintptr
	prev      uintptr
}

// ---------------------------------------------------------------------------
// Reserves
//
// THE CHUNK-LAYER BOUNDARY. Nothing above this layer may touch a reserve, a
// bitmap, or mmap -- the tiers see only chunk_of / chunk_alloc /
// chunk_release / chunk_first / chunk_next / desc / span_addr. That boundary is
// what keeps a later move to per-chunk mapping a constant change rather than a
// rewrite, and it is exactly the kind of thing that rots silently.
// ---------------------------------------------------------------------------

var res_base [64]uintptr
var res_used [256]i64
var res_free [64]i64
var res_count i64

// chunk_bit reports whether chunk i of reserve r is in use.
fn chunk_bit(r i64, i i64) i64 {
	w := res_used[r*RES_WORDS+i/64]
	return (w >> (i % 64)) & 1
}

fn chunk_bit_set(r i64, i i64) {
	idx := r*RES_WORDS + i/64
	res_used[idx] = res_used[idx] | (1 << (i % 64))
}

fn chunk_bit_clear(r i64, i i64) {
	idx := r*RES_WORDS + i/64
	res_used[idx] = res_used[idx] & ~(1 << (i % 64))
}

// reserve_new maps a fresh reserve, CHUNK_SIZE-aligned so that every chunk
// carved from it is also CHUNK_SIZE-aligned. Returns its index, or -1.
//
// Only CHUNK_SIZE alignment is needed, not RESERVE_SIZE alignment, so the
// over-allocation is one chunk rather than one reserve.
fn reserve_new() i64 {
	if (res_count >= MAX_RESERVES) {
		return 0 - 1
	}
	raw := sys.reserve_anon(RESERVE_SIZE + CHUNK_SIZE)
	if (raw == uintptr(0)) {
		return 0 - 1
	}
	base := (raw + CHUNK_MASK) & ~CHUNK_MASK

	head := i64(base - raw)
	if (head > 0) {
		_ := sys.munmap(raw, head)
	}
	tail := CHUNK_SIZE - head
	if (tail > 0) {
		_ := sys.munmap(base+uintptr(RESERVE_SIZE), tail)
	}

	r := res_count
	res_base[r] = base
	res_free[r] = CHUNKS_PER_RESERVE
	var w i64 := 0
	for (; w < RES_WORDS; w = w + 1) {
		res_used[r*RES_WORDS+w] = 0
	}
	res_count = res_count + 1
	return r
}

// reserve_of returns the index of the reserve containing p, or -1.
fn reserve_of(p uintptr) i64 {
	var r i64 := 0
	for (; r < res_count; r = r + 1) {
		b := res_base[r]
		if (p >= b && p < b+uintptr(RESERVE_SIZE)) {
			return r
		}
	}
	return 0 - 1
}

// ---------------------------------------------------------------------------
// Chunks
// ---------------------------------------------------------------------------

// chunk_of returns the chunk base containing p, or 0 if p is not in any chunk.
//
// A miss means the pointer is a huge allocation (mapped outside every reserve)
// or not ours at all. This is why free() cannot simply mask and dereference:
// for a huge pointer the masked address may be unmapped.
fn chunk_of(p uintptr) uintptr {
	r := reserve_of(p)
	if (r < 0) {
		return uintptr(0)
	}
	b := res_base[r]
	i := i64((p - b) / uintptr(CHUNK_SIZE))
	if (chunk_bit(r, i) == 0) {
		return uintptr(0)
	}
	return b + uintptr(i*CHUNK_SIZE)
}

// chunk_init prepares a freshly-claimed chunk's metadata.
fn chunk_init(base uintptr) {
	h := unsafe_cast(*mut chunk_hdr, base)
	h.base = base
	h.free_spans = SPANS_PER_CHUNK - METADATA_SPANS
	h.purged = 0

	// Span 0 is metadata and never allocatable; the rest start free and clean.
	// A chunk carved from a fresh reserve has never been written, and one
	// recycled after MADV_DONTNEED reads back as zero, so either way its pages
	// are known zero.
	d0 := desc(base, 0)
	d0.state = SPAN_LARGE_HEAD
	d0.runlen = METADATA_SPANS

	var i i64 := METADATA_SPANS
	for (; i < SPANS_PER_CHUNK; i = i + 1) {
		d := desc(base, i)
		d.state = SPAN_FREE
		d.clean = 1
	}
}

// chunk_alloc claims a chunk, growing by one reserve if none has a free one.
// Returns the chunk base, or 0.
fn chunk_alloc() uintptr {
	var r i64 := 0
	for (; r < res_count; r = r + 1) {
		if (res_free[r] > 0) {
			var i i64 := 0
			for (; i < CHUNKS_PER_RESERVE; i = i + 1) {
				if (chunk_bit(r, i) == 0) {
					chunk_bit_set(r, i)
					res_free[r] = res_free[r] - 1
					base := res_base[r] + uintptr(i*CHUNK_SIZE)
					chunk_init(base)
					return base
				}
			}
		}
	}
	nr := reserve_new()
	if (nr < 0) {
		return uintptr(0)
	}
	chunk_bit_set(nr, 0)
	res_free[nr] = res_free[nr] - 1
	base := res_base[nr]
	chunk_init(base)
	return base
}

// chunk_release returns a chunk to its reserve and drops its physical pages.
//
// The address range stays reserved -- MADV_DONTNEED is the "free" mechanism
// here, not munmap. Reacquiring the chunk costs page faults rather than an
// mmap, and the pages read back as zero, which is what lets chunk_init mark
// every span clean.
fn chunk_release(base uintptr) {
	r := reserve_of(base)
	if (r < 0) {
		return
	}
	i := i64((base - res_base[r]) / uintptr(CHUNK_SIZE))
	if (chunk_bit(r, i) == 0) {
		return
	}
	chunk_bit_clear(r, i)
	res_free[r] = res_free[r] + 1
	_ := sys.madvise(base, CHUNK_SIZE, sys.MADV_DONTNEED)
}

// chunk_first and chunk_next iterate the in-use chunks, so callers that need
// to scan chunks never learn how chunks are stored.
fn chunk_first() uintptr {
	return chunk_after(0, 0 - 1)
}

fn chunk_next(base uintptr) uintptr {
	r := reserve_of(base)
	if (r < 0) {
		return uintptr(0)
	}
	i := i64((base - res_base[r]) / uintptr(CHUNK_SIZE))
	return chunk_after(r, i)
}

// chunk_after returns the first in-use chunk strictly after chunk i of
// reserve r, scanning into later reserves as needed.
fn chunk_after(r i64, i i64) uintptr {
	var rr i64 := r
	var ii i64 := i + 1
	for (; rr < res_count; rr = rr + 1) {
		for (; ii < CHUNKS_PER_RESERVE; ii = ii + 1) {
			if (chunk_bit(rr, ii) == 1) {
				return res_base[rr] + uintptr(ii*CHUNK_SIZE)
			}
		}
		ii = 0
	}
	return uintptr(0)
}

// ---------------------------------------------------------------------------
// Chunk and span addressing
// ---------------------------------------------------------------------------

// span_index returns p's span number within its chunk.
fn span_index(p uintptr) i64 {
	return i64((p & CHUNK_MASK) / uintptr(SPAN_SIZE))
}

// span_base returns the base address of the span containing p.
fn span_base(p uintptr) uintptr {
	return p & ~SPAN_MASK
}

// desc returns the descriptor for span i of the chunk at base.
fn desc(base uintptr, i i64) *mut span_desc {
	off := i64(size_of(chunk_hdr)) + i*i64(size_of(span_desc))
	return unsafe_cast(*mut span_desc, base+uintptr(off))
}

// span_addr returns the base address of span i in the chunk at base.
fn span_addr(base uintptr, i i64) uintptr {
	return base + uintptr(i*SPAN_SIZE)
}

// ---------------------------------------------------------------------------
// Span allocation within chunks
// ---------------------------------------------------------------------------

// span_find_run returns the index of the first run of n free spans in the chunk
// at base, or -1 if there is none.
fn span_find_run(base uintptr, n i64) i64 {
	var i i64 := METADATA_SPANS
	for (; i+n <= SPANS_PER_CHUNK; ) {
		var j i64 := 0
		var ok i64 := 1
		for (; j < n; j = j + 1) {
			if (desc(base, i+j).state != SPAN_FREE) {
				ok = 0
				break
			}
		}
		if (ok == 1) {
			return i
		}
		// Skip past the span that failed rather than retrying every offset.
		i = i + j + 1
	}
	return 0 - 1
}

// span_take claims a run of n spans starting at index i, returning the base
// address of the run.
fn span_take(base uintptr, i i64, n i64) uintptr {
	h := unsafe_cast(*mut chunk_hdr, base)
	head := desc(base, i)
	head.state = SPAN_LARGE_HEAD
	head.runlen = n
	head.used = 0
	head.free_head = uintptr(0)

	var k i64 := 1
	for (; k < n; k = k + 1) {
		d := desc(base, i+k)
		d.state = SPAN_LARGE_TAIL
		d.runlen = 0
	}
	h.free_spans = h.free_spans - n
	return span_addr(base, i)
}

// span_give returns a run of n spans starting at index i to the chunk.
fn span_give(base uintptr, i i64, n i64) {
	h := unsafe_cast(*mut chunk_hdr, base)
	var k i64 := 0
	for (; k < n; k = k + 1) {
		d := desc(base, i+k)
		d.state = SPAN_FREE
		d.runlen = 0
		d.used = 0
		d.free_head = uintptr(0)
		d.next = uintptr(0)
		d.prev = uintptr(0)
		// The span's pages have been written, so it is no longer known-zero.
		// Only a purge (or a fresh mmap) restores that.
		d.clean = 0
	}
	h.free_spans = h.free_spans + n
}

// span_alloc finds n contiguous free spans in any registered chunk, growing the
// heap by one chunk if none has room. Returns the run's base address, or 0.
fn span_alloc(n i64) uintptr {
	// A run this long cannot fit in any chunk, so fail before mapping one --
	// otherwise an impossible request grows the heap by a chunk it can never
	// use and still returns failure.
	if (n > SPANS_PER_CHUNK-METADATA_SPANS) {
		return uintptr(0)
	}
	var base uintptr := chunk_first()
	for (; base != uintptr(0); base = chunk_next(base)) {
		h := unsafe_cast(*mut chunk_hdr, base)
		if (h.free_spans >= n) {
			i := span_find_run(base, n)
			if (i >= 0) {
				return span_take(base, i, n)
			}
		}
	}
	base = chunk_alloc()
	if (base == uintptr(0)) {
		return uintptr(0)
	}
	i := span_find_run(base, n)
	if (i < 0) {
		return uintptr(0)
	}
	return span_take(base, i, n)
}

// ---------------------------------------------------------------------------
// Introspection, for tests
// ---------------------------------------------------------------------------

// chunk_count is how many chunks are currently claimed. Tests use it to prove
// an alloc/free loop does not grow the heap without bound, which no assertion
// about returned values can show.
pub fn chunk_count() i64 {
	var n i64 := 0
	var base uintptr := chunk_first()
	for (; base != uintptr(0); base = chunk_next(base)) {
		n = n + 1
	}
	return n
}

// reserve_count is how many address-space reserves are mapped. This is what
// shows up as VSZ, so it is the number to watch when tuning RESERVE_SIZE.
pub fn reserve_count() i64 {
	return res_count
}

// free_span_count is the number of unallocated spans across all claimed chunks.
pub fn free_span_count() i64 {
	var total i64 := 0
	var base uintptr := chunk_first()
	for (; base != uintptr(0); base = chunk_next(base)) {
		h := unsafe_cast(*mut chunk_hdr, base)
		total = total + h.free_spans
	}
	return total
}

// chunk_base_at_for_test exposes the nth in-use chunk base, so tests can assert
// the CHUNK_SIZE-alignment invariant directly on every chunk rather than
// inferring it from a span address -- the kernel returns large mappings
// suitably aligned often enough that an inferred check passes by luck.
pub fn chunk_base_at_for_test(i i64) uintptr {
	var n i64 := 0
	var base uintptr := chunk_first()
	for (; base != uintptr(0); base = chunk_next(base)) {
		if (n == i) {
			return base
		}
		n = n + 1
	}
	return uintptr(0)
}

// reserve_base_at_for_test exposes a reserve base, so the CHUNK_SIZE-alignment
// invariant can be asserted on the thing that actually establishes it rather
// than on a chunk derived from it.
pub fn reserve_base_at_for_test(i i64) uintptr {
	if (i < 0 || i >= res_count) {
		return uintptr(0)
	}
	return res_base[i]
}

// reserve_new_for_test forces a fresh reserve. Exhausting one naturally takes
// 256 chunks, which is far too slow for a test, and one reserve gives the
// alignment assertion only a single sample -- the kernel returns large
// mappings 4MB-aligned about half the time, so a single sample passes by luck.
pub fn reserve_new_for_test() i64 {
	return reserve_new()
}

// chunk_alloc_for_test / chunk_release_for_test / chunk_of_for_test expose the
// chunk layer directly. Without them chunk_of can only be reached through a
// live span, so nothing distinguishes "this chunk is in use" from "this address
// is inside a reserve" -- a released chunk has to be observable.
pub fn chunk_alloc_for_test() uintptr {
	return chunk_alloc()
}

pub fn chunk_release_for_test(base uintptr) {
	chunk_release(base)
}

pub fn chunk_of_for_test(p uintptr) uintptr {
	return chunk_of(p)
}

// span_alloc_for_test and span_free_for_test expose the span layer directly so
// the chunk layer's invariants can be tested before any allocation tier is
// built on them. Not part of the allocator's interface; they go away at
// cutover.
pub fn span_alloc_for_test(n i64) uintptr {
	return span_alloc(n)
}

pub fn span_free_for_test(p uintptr, n i64) {
	base := chunk_of(p)
	if (base == uintptr(0)) {
		return
	}
	span_give(base, span_index(p), n)
}
