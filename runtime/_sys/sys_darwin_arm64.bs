package _sys

// Boson keeps its existing syscall-number surface; Darwin uses libSystem.
pub function syscall0
 type fn(i64) i64
 prologue
 mov x9 x0
 call dispatch
 epilogue
 mov x0 x8
 ret

pub function syscall1
 type fn(i64,i64) i64
 prologue
 mov x9 x0
 mov x0 x1
 call dispatch
 epilogue
 mov x0 x8
 ret

pub function syscall2
 type fn(i64,i64,i64) i64
 prologue
 mov x9 x0
 mov x0 x1
 mov x1 x2
 call dispatch
 epilogue
 mov x0 x8
 ret

pub function syscall3
 type fn(i64,i64,i64,i64) i64
 prologue
 mov x9 x0
 mov x0 x1
 mov x1 x2
 mov x2 x3
 call dispatch
 epilogue
 mov x0 x8
 ret

pub function syscall4
 type fn(i64,i64,i64,i64,i64) i64
